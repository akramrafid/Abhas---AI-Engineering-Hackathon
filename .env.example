# Abhas — environment variables. Copy to .env (npm run setup does this). The app runs with ZERO keys:
# every variable below is optional and has a safe default.

# --- App ---
APP_ENV=dev                      # optional — dev | test | prod
API_PORT=8000                    # optional
WEB_PORT=3000                    # optional
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000   # optional — public, never a secret
CORS_ORIGINS=http://localhost:3000               # optional — comma-separated

# --- Database (SQLite file by default; the same Alembic migrations run on Postgres for the final sprint) ---
DATABASE_URL=sqlite:///./data/abhas.db           # optional

# --- Model artifact ---
MODEL_PATH=apps/api/ml/artifacts/current.joblib  # optional — points at the committed model

# --- Weather (Open-Meteo: free, no key, non-commercial, CC BY 4.0) ---
WEATHER_MODE=dataset             # optional — dataset | live
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast   # optional
WEATHER_CACHE_TTL_HOURS=6        # optional

# --- Officer advisory LLM (COULD; deterministic template when empty) ---
ANTHROPIC_API_KEY=               # optional — secret; console.anthropic.com → API keys
LLM_MODEL=claude-haiku-5-5       # optional
LLM_MAX_OUTPUT_TOKENS=400        # optional
LLM_DAILY_BUDGET_USD=1           # optional — advisory stops at this daily spend

# --- Ops ---
OPS_TOKEN=                       # optional — random string (generated by envtool), protects /api/v1/ops
RATE_LIMIT_PER_MINUTE=120        # optional — per client IP
