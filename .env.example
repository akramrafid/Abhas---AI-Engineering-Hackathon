# --- App LLM (REQUIRED) — any OpenAI-compatible chat API ---
LLM_BASE_URL=https://api.openai.com/v1        # OpenAI-compatible endpoint (OpenRouter, Groq, Gemini-OpenAI, ...)
LLM_API_KEY=                                  # secret — from your provider console
LLM_MODEL=gpt-4o-mini                         # chat model name your provider lists
LLM_FALLBACK_MODEL=                           # optional — cheaper/faster backup model
LLM_MOCK=0                                    # 1 = deterministic fake responses (dev/tests without a key)
LLM_PRICE_IN_PER_MTOK=0.15                    # optional — USD per 1M input tokens, for cost logs
LLM_PRICE_OUT_PER_MTOK=0.60                   # optional — USD per 1M output tokens, for cost logs
# --- Embeddings: local multilingual model by default (no key) ---
EMBEDDING_PROVIDER=local                      # local (fastembed, CPU) | openai (uses LLM_BASE_URL/LLM_API_KEY)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# --- Vector DB: Qdrant local mode (no Docker, no key) ---
QDRANT_PATH=./.qdrant                         # embedded Qdrant storage folder
QDRANT_URL=                                   # optional — server URL instead of local mode
QDRANT_COLLECTION=lumadesk_kb
# --- App data ---
DATABASE_URL=sqlite:///./lumadesk.db          # local SQLite (not a secret)
DATA_DIR=../../data                           # relative to apps/api
# --- Server ---
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000     # browser → API base URL (not a secret)
LLM_REASONING_EFFORT=none                     # optional — none|low|medium|high; none = fastest on Gemini 2.5 Flash
