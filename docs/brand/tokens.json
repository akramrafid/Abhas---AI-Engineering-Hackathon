      "weights": [
        300,
        400,
        500,
        600,
        700,
        800
      ],
      "npm": "@fontsource/poppins"
    },
    "mono": {
      "family": "Poppins",
      "fallback": "system-ui, sans-serif",
      "weights": [
        400,
        500,
        600
      ],
      "npm": "@fontsource/poppins"
    },
    "bangla": {
      "family": "Noto Sans Bengali",
      "fallback": "sans-serif",
      "weights": [
        400,
        600,
        700
      ],
      "npm": "@fontsource-variable/noto-sans-bengali"
    }
  },
  "type": {
    "display": {
      "font": "sans",
      "weight": 300,
      "size": 48,
