{
  "name": "Abhas",
  "version": "1.0.0",
  "color": {
    "brand": {
      "ink": {
        "value": "#0B0F14",
        "role": "Base. Dark grounds; body text on light (19.2:1 on white)."
      },
      "navy": {
        "value": "#0B1A5C",
        "role": "Depth. Section pages, headings (16.0:1 on white)."
      },
      "royal": {
        "value": "#2F5BFF",
        "role": "Primary. Logo, links, buttons, charts (5.2:1 on white; white text on royal 5.2:1)."
      },
      "lime": {
        "value": "#D4F53C",
        "role": "The accent. One highlight per view, ONLY on Ink/Navy/Royal (1.2:1 on white). Never in data views."
      },
      "white": {
        "value": "#FFFFFF",
        "role": "Text on dark, clean grounds."
      }
    },
    "neutral": {
      "slate": {
        "value": "#4B5578",
        "role": "Secondary text (7.3:1 on white)"
      },
      "mist": {
        "value": "#DDE3F3",
        "role": "Lines, borders. Never text."
      },
      "paper": {
        "value": "#F4F6FD",
        "role": "Page ground"
      },
      "white": {
        "value": "#FFFFFF"
      }
    },
    "risk": {
      "low": {
        "value": "#BFE3CC",
        "on": "#16202B",
        "label": {
          "en": "Low",
          "bn": "নিম্ন"
        },
        "meter": 1,
        "action": "Routine surveillance."
      },
      "medium": {
        "value": "#F0B429",
        "on": "#16202B",
        "label": {
          "en": "Medium",
          "bn": "মাঝারি"
        },
        "meter": 2,
        "action": "Inspect breeding sites this week."
      },
      "high": {
        "value": "#C2410C",
        "on": "#FFFFFF",
        "label": {
          "en": "High",
          "bn": "উচ্চ"
        },
        "meter": 3,
        "action": "Larvicide hotspots; alert clinics."
      },
      "critical": {
        "value": "#7F1D1D",
