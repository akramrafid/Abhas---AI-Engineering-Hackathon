        "label": {
          "en": "Critical",
          "bn": "সংকটপূর্ণ"
        },
        "meter": 4,
        "action": "Deploy teams now; ready beds and saline."
      },
      "lowCellBorder": {
        "value": "#9FCBB0"
      },
      "forecastBand": {
        "value": "rgba(47,91,255,0.15)",
