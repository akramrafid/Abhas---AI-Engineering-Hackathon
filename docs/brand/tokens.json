    16,
    24,
    32,
    48,
    64
  ],
  "logo": {
    "grid": 48,
    "construction": "Drop (circle r=15 at 24,30.5; tip 24,3) cut by a Λ line (0,41.2)-(24,16)-(48,41.2), 3 units wide. Above = sky cap (Royal; Lime on dark), below = city (Navy; White on dark).",
    "versions": {
      "primary": "cap #2F5BFF / city #0B1A5C on White or light tints",
      "reverse": "cap #D4F53C / city #FFFFFF on Ink, Navy or Royal",
      "mono": "black or white, one colour"
    },
    "clearSpace": "0.25 x symbol height on every side",
    "minSize": {
      "lockupPx": 120,
      "lockupMm": 30,
      "symbolPx": 24,
      "symbolMm": 6,
      "faviconPx": 16
    },
    "wordmark": "ABHAS in Manrope 800, uppercase, letter-spacing 0.08em; outline the text before shipping",
    "lockup": "symbol height = 1.18 x font size; gap = 0.34 x font size",
    "banglaLockup": "symbol + আভাস in Noto Sans Bengali 700",
    "cityEdition": "city name in Manrope 600, 0.52 x wordmark size, Royal, under the wordmark"
  },
  "graphics": {
    "ribbons": [
      "art/abhas-ribbon-hero.svg",
      "art/abhas-ribbon-fan.svg",
      "art/abhas-ribbon-strip.svg"
    ],
    "rule": "Covers, section pages, hero bands only, on Ink or Navy. Never behind data."
  },
  "nameBangla": "আভাস"
}